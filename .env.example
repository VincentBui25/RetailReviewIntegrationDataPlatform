# Official setup: pwsh -File ./scripts/Invoke-DuckDbPilot.ps1
# Only PowerShell 7.2+ and Docker Compose v2 are required on the host.
# Explicit runner arguments > existing process environment > this file > defaults.
FNB_SUPERSET_PORT=18101
FNB_DBT_DOCS_PORT=18102
FNB_POSTGRES_PORT=15501
FNB_AIRFLOW_PORT=18103

# Real mode only: host directories (relative to repository root or absolute).
# Demo generates invented sources and uses none of these publications.
FNB_BUSINESS_INPUT_ROOT=./.local/inputs/business
FNB_DEMOGRAPHICS_INPUT_ROOT=./.local/inputs/demographics
FNB_AREA_RELEASES_ROOT=./.local/inputs/area
FNB_AREA_DBT_RELEASE=
FNB_INPUT_ROOT=./config
FNB_DEMO_VOLUME=fnb-platform_demo_outputs

# Required in Real mode; use explicit immutable releases and their manifest SHA256.
# Paths below are CONTAINER paths: /demo, /business-input and /area-input mounts.
# Example shape: /demo/<campaign>/gold/releases/<release-id>
FNB_GOLD_RELEASE=
FNB_GOLD_MANIFEST_SHA256=
FNB_ANALYTICS_RELEASE=
FNB_ANALYTICS_MANIFEST_SHA256=
FNB_DEMOGRAPHICS_RELEASE=
FNB_DEMOGRAPHICS_MANIFEST_SHA256=

# No passwords/cookies/DSNs belong in Git. The runner creates missing per-run
# secret files under .local/duckdb-final/<RunName>/secrets without replacing them.
# Internal postgres:5432, fnb_admin, fnb_superset_metadata/fnb_superset are
# fixed service/SQL contracts, independent of host ports or author accounts.
# dbt profiles and FNB_WAREHOUSE_DUCKDB/FNB_DBT_DATABASE are selected by the runner.
